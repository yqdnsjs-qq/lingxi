# ============ 换行与编码（跨 Windows / Linux 用）============
# 统一 LF：服务器（Linux）那边 shell / service 文件必须是 LF，否则 systemd 会报错
* text=auto eol=lf

# Windows 批处理是 GBK 编码 + 必须 CRLF，交给 git 原样存，别做任何转换
*.bat -text
*.cmd -text

# 明确按 LF
*.sh text eol=lf
*.service text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.ini text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.db binary
