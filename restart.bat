@echo off
chcp 936 >nul
title 宇之语·灵犀 - 重启
cd /d "%~dp0"

rem ============================================================
rem  先停止再启动。改完 config.ini 或想清掉残留进程时用这个。
rem  也可以带参数：restart.bat search
rem ============================================================

echo ============================================================
echo   宇之语·灵犀 - 重启服务
echo ============================================================
echo.

call "%~dp0stop.bat"

echo.
echo 正在重新启动…
echo.
call "%~dp0start.bat" %*
exit /b %errorlevel%
