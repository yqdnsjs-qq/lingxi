@echo off
chcp 936 >nul
title 宇之语·灵犀 - 换路径（NAS 聚合后用）
cd /d "%~dp0"

rem ============================================================
rem  把索引库里的路径前缀换成新的访问地址
rem  数据全保留：向量、人脸、片段都挂在文件 id 上，id 不变
rem  默认先"演练"，确认没问题才真的改
rem ============================================================

set "ROOT=%~dp0"
if "%ROOT:~-1%"=="\" set "ROOT=%ROOT:~0,-1%"
set "PY=%ROOT%\venv\Scripts\python.exe"
set "TOOL=%ROOT%\app\remap_paths.py"

if not exist "%PY%" (
  echo [错误] 找不到 %PY%
  pause
  exit /b 1
)
if not exist "%TOOL%" (
  echo [错误] 找不到 %TOOL%
  pause
  exit /b 1
)

cls
echo ============================================================
echo   换路径（NAS 聚合后用）
echo ============================================================
echo.
echo   用途：NAS 上的文件夹聚合成新盘符后，把索引库里的旧路径
echo         换成新路径。**已扫描的数据全部保留**，
echo         不需要重新扫描，人脸和向量都还在。
echo.
echo   不要做的事：在界面上"添加新文件夹 + 删除旧文件夹" ——
echo               那会让已扫描的数据全部作废。
echo.
echo ------------------------------------------------------------
echo.

set "OLD="
set /p OLD=  旧前缀（例：\\NAS\photo ）: 
if not defined OLD goto :END

set "NEW="
set /p NEW=  新前缀（例：P: ）: 
if not defined NEW goto :END

echo.
echo ------------------------------------------------------------
echo   第 1 步：演练（不会改动任何数据）
echo ------------------------------------------------------------
echo.
"%PY%" "%TOOL%" --old "%OLD%" --new "%NEW%"
if errorlevel 1 (
  echo.
  echo   [错误] 演练失败，请检查上面的输出。
  pause
  goto :END
)

echo.
echo ============================================================
echo   演练完成。请确认上面：
echo     · "会改动" 的文件夹和文件数量对不对
echo     · "新路径存在：是"  <<< 必须看到这个，否则别继续
echo ============================================================
echo.
set "GO="
set /p GO=  确认无误要执行吗？输入 YES 继续: 
if /i not "%GO%"=="YES" goto :END

echo.
echo ------------------------------------------------------------
echo   第 2 步：正式执行（会先自动备份整个索引库）
echo ------------------------------------------------------------
echo.
"%PY%" "%TOOL%" --old "%OLD%" --new "%NEW%" --apply

echo.
echo ============================================================
echo   完成。
echo.
echo   下一步：
echo     1. 双击 search.bat 启动服务
echo     2. 在界面上点一次「增量更新」
echo     3. 应该全部"跳过"（文件没变）—— 说明数据对上了
echo        如果反而显示大量"新建"，说明新路径下的文件
echo        取值和原来不同，先停下告诉我
echo ============================================================

:END
echo.
pause
exit /b 0
